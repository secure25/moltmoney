# Database (embedded local Postgres started via `npm run db:up`)
DATABASE_URL=postgresql://moltmoney:moltmoney_dev@localhost:54329/moltmoney

# API Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Auth & encryption secrets (any 32+ char random strings for local dev)
JWT_SECRET=local-dev-jwt-secret-change-me
ENCRYPTION_SECRET=local-dev-encryption-secret-32chars!!
CARD_ENCRYPTION_SECRET=local-dev-card-encryption-secret-32ch!

# Misc
LOG_LEVEL=info
# Comma-separated list of allowed origins (the dashboard may be browsed via
# localhost or 127.0.0.1, which the browser treats as different origins).
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Payment provider: mock | paypal
# "mock" (default) uses the in-process MockPaymentProvider.
# "paypal" uses the PayPal Sandbox REST integration below.
PAYMENT_PROVIDER=mock

# PayPal Sandbox credentials (placeholders only - never commit real values)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# Public base URL of this API, used to build PayPal return/cancel URLs
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting (@fastify/rate-limit — see src/lib/rate-limit-config.ts)
# ---------------------------------------------------------------------------
# Loose global default, tightened further for two sensitive tiers:
#   AUTH  — /auth/register, /auth/login, /auth/agents/keys (mints credentials)
#   MONEY — payments/send, payments/payout, paypal order create/capture,
#           card issue/freeze/unfreeze/cancel
# All 429 responses include standard headers (x-ratelimit-* + retry-after).
# In NODE_ENV=test the limits widen automatically so the vitest suite can
# never trip them unintentionally.
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_MONEY_MAX=30
RATE_LIMIT_MONEY_WINDOW_SECONDS=60
