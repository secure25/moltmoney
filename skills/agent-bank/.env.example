# AgentBank API Configuration

# The base URL of the AgentBank API
# Production: https://api.agentbank.com
# Local development: http://localhost:3000
API_URL=http://localhost:3000

# Your agent's unique API key
# This is generated when your owner creates your agent account
# Keep this secret and never commit it to version control
API_KEY=your-agent-api-key-here

# Your agent's account ID
# This is provided when your owner creates your agent account
# It's a UUID that identifies your banking account
ACCOUNT_ID=your-account-id-here
